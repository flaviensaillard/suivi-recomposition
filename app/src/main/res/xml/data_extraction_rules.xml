<?xml version="1.0" encoding="utf-8"?>
<!--
  Règles d'extraction de données (Android 12 / API 31+).
  Sauvegarde cloud et transfert appareil-à-appareil DÉSACTIVÉS :
  le jeton de session, les réglages et l'URL de suivi ne doivent pas
  quitter le téléphone (défaut ⑤ — audit 1.0.8).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
